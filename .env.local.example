# Copy this file as `.env.local` and fill in values from Supabase
# (Dashboard -> Project Settings -> API / API Keys). .env.local is NOT committed to git.

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# PUBLISHABLE key (sb_publishable_...) — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SECRET key (sb_secret_...) — server-side only, never commit or expose to the browser.
# Settings -> API Keys -> Secret keys.
SUPABASE_SECRET_KEY=sb_secret_...

# Shared password to enter the site. Empty = gate disabled.
SITE_PASSWORD=

# GUEST password — read-only access. Empty = no guest mode.
SITE_GUEST_PASSWORD=
