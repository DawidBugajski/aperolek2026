# Skopiuj ten plik jako `.env.local` i wklej wartości z Supabase
# (Dashboard -> Project Settings -> API / API Keys). Plik .env.local NIE trafia do gita.

# URL projektu (Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co

# Klucz PUBLISHABLE (sb_publishable_...) - bezpieczny do przeglądarki
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Klucz SECRET (sb_secret_...) - SEKRETNY, tylko serwer.
# Settings -> API Keys -> Secret keys. Nigdy nie commituj, nigdy w kodzie klienta.
SUPABASE_SECRET_KEY=sb_secret_...

# Wspólne hasło wejścia na stronę. Puste = bramka wyłączona.
SITE_PASSWORD=

# Hasło GOŚCIA - podgląd bez edycji. Puste = brak trybu gościa.
SITE_GUEST_PASSWORD=
